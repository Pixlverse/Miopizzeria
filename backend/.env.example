NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/miopizzeria
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=change_me_too
REFRESH_TOKEN_EXPIRY=30d
# Image uploads — from the Cloudinary dashboard (Settings → API Keys).
# Leave empty to disable uploads; the admin falls back to pasting an image URL.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level Cloudinary folder; images land in <folder>/menu and <folder>/gallery.
CLOUDINARY_FOLDER=miopizzeria
CORS_ORIGIN=http://localhost:3000

# Used by `npm run seed` to create the first admin user
ADMIN_EMAIL=admin@miopizzeria.qa
ADMIN_PASSWORD=changeme123

# ---- Email alerts for new reservations / party orders ----
# smtp | ethereal | log | off
#   ethereal = local testing; the mail is captured and a preview URL is printed
EMAIL_PROVIDER=ethereal
# Where alerts land. Comma-separate for several inboxes.
EMAIL_NOTIFY_TO=adarshspillai2001@gmail.com
EMAIL_FROM=Mio Pizzeria <no-reply@miopizzeria.qa>
# Timezone used to format dates in the alert.
NOTIFY_TIMEZONE=Asia/Qatar
# Optional: adds an "Open admin panel" button to the email.
ADMIN_URL=http://localhost:3000/admin

# --- provider: smtp (real delivery) ---
# Gmail: host smtp.gmail.com, port 587, SMTP_PASS = a 16-char App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- WhatsApp alerts (owner notification) ----
# meta | twilio | log | off   ("log" prints the message instead of sending)
WHATSAPP_PROVIDER=log
# The restaurant's WhatsApp — where alerts land. Comma-separate for several.
WHATSAPP_NOTIFY_TO=97460064003

# --- provider: meta (WhatsApp Cloud API) ---
# Meta for Developers -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Needed whenever the recipient hasn't messaged the business in the last 24h.
# Use an approved Utility template whose body is a single {{1}} placeholder.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# --- provider: twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender is +14155238886 (recipients must first WhatsApp it "join <code>")
TWILIO_WHATSAPP_FROM=14155238886

# Country code assumed for guests who type a bare local number.
DEFAULT_COUNTRY_CODE=974
